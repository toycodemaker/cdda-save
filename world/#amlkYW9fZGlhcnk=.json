  "pages": [ { "text": "到今天为止已经过去了差不多一季的时间了。\n从开始的时候遗忘了记忆到今天已然过去了一季的时间了，从开始的一无所有到现在拥有了一个基地的物资储备，从只有两个人到如今的四个人，确实经历了很多很多。 \n无数次从尸山血海里走出来，学会了众多的新技能，我想这是我之前无法想象的（如果我之前不会的话）。\n现在我已然拥有了一辆卡车，动力强劲。还有一组完备的工具，足以支持我制造数量众多的物品，同时我实现了通电，现在我可以在一个冰箱中存贮我的食物而不是只能看着他们变质。\n今天刚刚完成了蒸汽机的一个重要部件的制造工作，距离我最终制造出蒸汽机又近了很多。", "turn": 12628915, "time_accuracy": 2, "completed": [ 1 ], "active": [ 6 ], "faild": [  ], "kills": { "mon_skeleton": 4, "mon_zombie": 258, "mon_zombie_crawler": 8, "mon_zombie_fat": 69, "mon_zombie_rot": 19, "mon_bear": 1, "mon_black_rat": 1, "mon_chicken": 1, "mon_otter": 1, "mon_pig": 1, "mon_wolf": 1, "mon_zombie_smoker": 1, "mon_zombie_soldier": 31, "mon_zombie_survivor": 1, "mon_turret_searchlight": 2, "mon_dermatik_larva": 8, "mon_zombie_cop": 8, "mon_zombie_fireman": 5, "mon_copbot": 1, "mon_riotbot": 2, "mon_shifting_mass": 1, "mon_impossible_shape": 2, "mon_dog": 1, "mon_feral_soldier": 8, "mon_zombie_shady": 5, "mon_zombie_dog": 52, "mon_dog_zombie_rot": 25, "mon_dog_pitbullmix": 1, "mon_dog_boxer": 1, "mon_dog_dachshund": 3, "mon_dog_rottweiler": 1, "mon_zombie_child": 46, "mon_zombie_static": 10, "mon_zombie_hazmat": 5, "mon_zombie_electric": 4, "mon_zombie_swimmer_base": 12, "mon_zombie_tough": 48, "mon_sewer_fish": 5, "mon_sewer_rat": 10, "mon_gator": 2, "mon_frog": 1, "mon_zombullfrog": 3, "mon_zoose": 1, "mon_dog_zombie_cop": 6, "mon_feral_human_axe": 7, "mon_zombie_runner": 11, "mon_large_cockroach": 4, "mon_pregnant_giant_cockroach": 1, "mon_giant_cockroach_nymph": 1, "mon_wasp_small": 6, "mon_wasp": 2, "mon_worm_small": 1, "mon_crow_chick": 1, "mon_diving_larva": 2, "mon_fish_redbreast": 1, "mon_zombie_thorny": 2, "mon_zombie_necro": 1, "mon_zombie_brute": 1, "mon_flaming_eye": 1, "mon_feral_human_pipe": 7, "mon_feral_human_crowbar": 12, "mon_zombie_medical": 3, "mon_zombie_military_pilot": 1, "mon_zombie_soldier_acid_1": 1, "mon_zombie_kevlar_1": 1, "mon_zombie_soldier_blackops_1": 1, "mon_zombie_scorched": 2, "mon_zombie_brainless": 15, "mon_zombie_swat