  "player_messages": { "messages": [ { "turn": 15280118, "message": "怀亚特·罗伯茨 可以协助你进行批量制造……", "count": 1, "type": 4 }, { "turn": 15280200, "message": "劳累之后的休息让你感觉自己好些了。", "count": 1, "type": 0 }, { "turn": 15280201, "message": "你把 碎木 丢在 壁炉 上。", "count": 1, "type": 5 }, { "turn": 15280201, "message": "长期辛苦的劳作让你非常疲惫。", "count": 1, "type": 4 }, { "turn": 15280244, "message": "你觉得自己疲惫不堪，持续进行这种强度的活动会变慢。", "count": 1, "type": 1 }, { "turn": 15280261, "message": "劳累之后的休息让你感觉自己好些了。", "count": 1, "type": 0 }, { "turn": 15280290, "message": "玛丽亚·库克 看着你制造……", "count": 1, "type": 4 }, { "turn": 15280402, "message": "怀亚特·罗伯茨 可以协助你进行批量制造……", "count": 1, "type": 4 }, { "turn": 15280415, "message": "怀亚特·罗伯茨 可以协助你进行批量制造……", "count": 1, "type": 4 }, { "turn": 15280464, "message": "怀亚特·罗伯茨 可以协助你进行批量制造……", "count": 1, "type": 4 }, { "turn": 15280500, "message": "长期辛苦的劳作让你非常疲惫。", "count": 1, "type": 4 }, { "turn": 15280689, "message": "罗伯特·摩尔 可以协助你进行批量制造……", "count": 1, "type": 4 }, { "turn": 15280708, "message": "你把 碎木 丢在 壁炉 上。", "count": 1, "type": 5 }, { "turn": 15280737, "message": "玛丽亚·库克 看着你制造……", "count": 1, "type": 4 }, { "turn": 15280879, "message": "你把 碎木 丢在 壁炉 上。", "count": 1, "type": 5 }, { "turn": 15280897, "message": "玛丽亚·库克 看着你制造……", "count": 1, "type": 4 }, { "turn": 15281080, "message": "你把 碎木 丢在 壁炉 上。", "count": 1, "type": 5 }, { "turn": 15281536, "message": "你把 碎木 丢在 壁炉 上。", "count": 1, "type": 5 }, { "turn": 15281577, "message": "玛丽亚·库克 看着你制造……", "count": 1, "type": 4 }, { "turn": 15281777, "message": "玛丽亚·库克 看着你制造……", "count": 1, "type": 4 }, { "turn": 15281863, "message": "你把 碎木 丢在 壁炉 上。", "count": 1, "type": 5 }, { "turn": 15281977, "message": "怀亚特·罗伯茨 可以协助你进行批量制造……", "count": 1, "type": 4 }, { "turn": 15281983, "message": "玛丽亚·库克 看着你制造……", "count": 1, "type": 4 }, { "turn": 15282109, "message": "你把 碎木 丢在 壁炉 上。", "count": 1, "type": 5 }, { "turn": 15282182, "message": "你感到你的右臂开始升温。", "count": 1, "type": 3 }, { "turn": 15282186, "message": "怀亚特·罗伯茨 可以协助你进行批量制造……", "